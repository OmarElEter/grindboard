{
  "name": "grindboard-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Grindboard as a native iPhone app (Capacitor). The web app in the repo root is copied into www/ at build time.",
  "scripts": {
    "copy-web": "mkdir -p www && cp ../index.html ../icon-192.png ../icon-512.png ../apple-touch-icon.png ../manifest.webmanifest www/",
    "sync": "npm run copy-web && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
